# Node.js Tutorial Application - Git Ignore Configuration
# This file specifies intentionally untracked files that Git should ignore
# Prevents version control tracking of temporary files, dependencies, and sensitive data

# =============================================================================
# NODE.JS DEPENDENCIES
# =============================================================================
# Dependency directories installed by npm/yarn
# These should be excluded as they can be regenerated from package.json
node_modules/

# Package manager lock files (uncomment to exclude)
# npm-shrinkwrap.json
# package-lock.json
# yarn.lock

# Package manager debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Environment variables files containing sensitive configuration data
# These files should never be committed to prevent exposure of API keys,
# database credentials, and other sensitive information
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================================================================
# RUNTIME AND PROCESS FILES
# =============================================================================
# Process ID files and seed files generated during application runtime
*.pid
*.seed
*.pid.lock

# Operating system generated files
# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Windows system files and thumbnails
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux temporary files and NFS locks
*~
.nfs*

# =============================================================================
# COVERAGE AND TEST REPORTS
# =============================================================================
# Test coverage reports generated by testing frameworks
# These are generated files that should not be version controlled
coverage/
.nyc_output
*.lcov
.coverage
test-results/

# Jest coverage directory
coverage/

# Istanbul coverage reports
.nyc_output

# =============================================================================
# IDE AND EDITOR FILES
# =============================================================================
# Visual Studio Code settings and workspace files
.vscode/

# JetBrains IDEs (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim editor temporary files
*.swp
*.swo

# Emacs temporary files
*~

# Sublime Text settings
*.sublime-project
*.sublime-workspace

# =============================================================================
# BUILD AND DISTRIBUTION
# =============================================================================
# Build output directories
dist/
build/

# Distribution packages
*.tgz
*.tar.gz

# Webpack build outputs
public/build/

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
# Application logs and log directories
logs/
*.log

# Temporary directories and files
tmp/
temp/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# ESLint cache
.eslintcache

# Prettier cache
.prettiercache

# Stylelint cache
.stylelintcache

# =============================================================================
# MISCELLANEOUS
# =============================================================================
# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# =============================================================================
# SECURITY NOTES
# =============================================================================
# This .gitignore configuration provides security by:
# 1. Excluding .env files that may contain API keys and credentials
# 2. Preventing accidental commit of node_modules with potential vulnerabilities
# 3. Excluding log files that may contain sensitive runtime information
# 4. Protecting against commit of temporary files with sensitive data

# =============================================================================
# MAINTENANCE GUIDELINES
# =============================================================================
# 1. Keep patterns minimal and specific to avoid excluding legitimate files
# 2. Document any custom patterns added for project-specific requirements
# 3. Regularly review patterns to ensure they match current project structure
# 4. Test .gitignore patterns using 'git check-ignore -v <filename>' command