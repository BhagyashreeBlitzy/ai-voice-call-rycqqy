# =============================================================================
# .gitignore for Node.js Tutorial Application
# =============================================================================
# Git ignore configuration file that defines patterns for files and directories 
# that should be excluded from version control for the Node.js tutorial application.
# Implements comprehensive ignore patterns for Node.js dependencies, build artifacts, 
# environment configuration files, test coverage reports, log files, temporary 
# directories, IDE settings, OS-specific files, and security-sensitive content.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js Dependencies and Package Management
# -----------------------------------------------------------------------------
# Exclude Node.js specific files including node_modules, npm logs, and 
# package-lock artifacts for Node.js v22.11.0 LTS development environment
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.node_repl_history
.yarn-integrity
package-lock.json.bak

# -----------------------------------------------------------------------------
# Environment Configuration Files
# -----------------------------------------------------------------------------
# Prevent environment variables, secrets, and deployment-specific configuration 
# from being committed to version control for security
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
config/local.json
config/production.json
config/staging.json

# -----------------------------------------------------------------------------
# Testing Artifacts and Coverage Reports
# -----------------------------------------------------------------------------
# Exclude Jest coverage reports, test artifacts, and temporary testing files 
# for Jest ^29.7.0 testing framework with 95% coverage threshold
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml
.jest-cache/
*.test.log

# -----------------------------------------------------------------------------
# Logging and Runtime Files
# -----------------------------------------------------------------------------
# Exclude application logs, temporary files, and runtime artifacts for 
# console-based logging and development monitoring
logs/
*.log
log/
tmp/
temp/
.cache/
pids/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Build Artifacts and Distribution Files
# -----------------------------------------------------------------------------
# Exclude build artifacts and distribution files as they are generated during 
# deployment and CI/CD processes
dist/
build/
out/
lib-cov/
.grunt
.lock-wscript
*.tgz
*.tar.gz
.dockerignore.backup

# -----------------------------------------------------------------------------
# Docker Containerization Files
# -----------------------------------------------------------------------------
# Exclude Docker build cache, container artifacts, and temporary build files 
# for multi-stage Docker container deployment
.dockerignore.bak
docker-compose.override.yml
.docker/
*.dockerfile.backup

# -----------------------------------------------------------------------------
# IDE and Text Editor Configuration
# -----------------------------------------------------------------------------
# Exclude personal IDE settings and editor-specific files while allowing 
# project-wide configurations to be shared
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.settings/
nbproject/
.buildpath
.sublime-workspace
.atom/
.brackets.json

# -----------------------------------------------------------------------------
# Operating System Generated Files
# -----------------------------------------------------------------------------
# Exclude OS-specific metadata files that provide no value to the project 
# and can cause cross-platform issues
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Security-Sensitive Files
# -----------------------------------------------------------------------------
# Prevent accidental commit of security certificates, private keys, and 
# credential files to maintain application security
*.pem
*.key
*.crt
*.csr
.ssh/
*.p12
*.pfx
secrets/
certificates/
.secrets

# -----------------------------------------------------------------------------
# Performance Monitoring and Profiling
# -----------------------------------------------------------------------------
# Exclude performance profiling data and monitoring artifacts as they are 
# environment-specific and regenerated during analysis
*.heapdump
*.cpuprofile
.clinic/
flamegraph.html
perf.data
monitoring-data/
metrics/
.0x/