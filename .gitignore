# =============================================================================
# .gitignore for Node.js/Express.js Tutorial Application
# =============================================================================
# This file specifies intentionally untracked files and directories to be 
# ignored by Git in the Node.js tutorial application. Ensures that sensitive, 
# environment-specific, build, dependency, and system files are not committed 
# to version control, supporting security, clean repository hygiene, and best 
# practices for Node.js/Express.js projects.
#
# Node.js Version: v22.x LTS (Jod)
# Express.js Version: v5.1.0
# Package Manager: npm v11.4.2
# =============================================================================

# =============================================================================
# DEPENDENCIES AND NODE MODULES
# =============================================================================
# Exclude all installed npm packages and dependency directories
# Node.js applications rely heavily on npm packages which can contain thousands
# of files and should be installed via 'npm install' rather than committed

# npm package directory - contains all installed dependencies
node_modules/

# npm cache directory (may be generated during installation)
.npm/

# Optional npm cache directory
.npm-cache/

# Yarn dependency directories (if Yarn is used as package manager)
.yarn/
.yarn-integrity

# pnpm dependency directories (if pnpm is used as package manager)
.pnpm-store/
.pnpm-debug.log*

# =============================================================================
# PACKAGE MANAGER LOGS AND DEBUG FILES
# =============================================================================
# Various package managers generate debug and error logs during installation
# or operation. These files contain debugging information and should not be
# committed as they are environment-specific and can contain sensitive paths

# npm debug logs generated during package installation or execution errors
npm-debug.log*

# Yarn debug and error logs
yarn-debug.log*
yarn-error.log*

# pnpm debug logs
pnpm-debug.log*

# =============================================================================
# BUILD ARTIFACTS AND DISTRIBUTION FILES
# =============================================================================
# Generated files from build processes, compilation, or bundling should not be
# committed as they can be regenerated from source code and may differ between
# environments

# Distribution directory containing compiled/bundled code
dist/

# Build output directory
build/

# Compiled output directories
out/
lib/
public/build/

# =============================================================================
# TESTING AND COVERAGE REPORTS
# =============================================================================
# Test coverage reports and testing artifacts are generated during test
# execution and should not be committed as they vary with each test run

# Code coverage reports generated by tools like NYC, Jest, or Istanbul
coverage/

# NYC (Istanbul) output directory for coverage reports
.nyc_output/

# Test result files
test-results/
junit.xml

# =============================================================================
# ENVIRONMENT CONFIGURATION AND SECRETS
# =============================================================================
# Environment-specific configuration files containing sensitive information
# such as API keys, database credentials, or environment-specific settings
# CRITICAL FOR SECURITY: These files must never be committed to prevent
# credential leaks and security vulnerabilities

# Environment variable files containing sensitive configuration
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local configuration files
config.local.js
config.local.json

# =============================================================================
# OPERATING SYSTEM GENERATED FILES
# =============================================================================
# Files automatically generated by operating systems that are not relevant
# to the application and can cause issues when committed across different OS

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows system files
Desktop.ini
$RECYCLE.BIN/

# Linux system files
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# TEMPORARY AND CACHE FILES
# =============================================================================
# Temporary files and caches that are automatically generated and can be
# safely regenerated or are only relevant for the current session

# Local development cache files
*.local

# Temporary directories and files
tmp/
temp/
.tmp/
.temp/

# Cache directories
.cache/
.eslintcache
.stylelintcache

# =============================================================================
# LOG FILES
# =============================================================================
# Application logs, server logs, and debugging logs that are generated during
# runtime and contain environment-specific information

# Log directories and files
logs/
*.log

# Specific log files that may be generated
npm-debug.log*
error.log
access.log
combined.log

# PM2 logs (if using PM2 for process management)
.pm2/

# =============================================================================
# DEVELOPMENT TOOLS AND IDE CONFIGURATION
# =============================================================================
# IDE and text editor configuration files that are user-specific and should
# not be shared across the development team as they represent personal
# preferences and local development environment setup

# Visual Studio Code settings (user-specific)
.vscode/
.vscode-test/

# JetBrains IDEs (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim editor files
*.swp
*.swo
*~

# Emacs editor files
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# RUNTIME AND PROCESS FILES
# =============================================================================
# Files generated during application runtime such as process IDs and runtime
# state files that are specific to the current execution environment

# Process ID files
*.pid
*.seed
*.pid.lock

# Runtime data
pids/
.grunt/

# =============================================================================
# SECURITY AND CERTIFICATES
# =============================================================================
# Security-related files such as private keys, certificates, and authentication
# tokens that must never be committed for security reasons

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx

# Authentication tokens and secrets
.secrets/
secrets/

# =============================================================================
# DOCUMENTATION GENERATION
# =============================================================================
# Generated documentation files that can be recreated from source code
# comments and should not be committed

# JSDoc generated documentation
docs/generated/
jsdoc/

# API documentation
api-docs/

# =============================================================================
# PERFORMANCE AND PROFILING
# =============================================================================
# Performance profiling data and benchmarking results that are session-specific
# and not relevant for version control

# V8 profiling data
*.cpuprofile
*.heapprofile
*.heapsnapshot

# Performance monitoring
.clinic/

# =============================================================================
# ADDITIONAL NODE.JS SPECIFIC IGNORES
# =============================================================================
# Additional files and patterns specific to Node.js development that may
# be generated by various tools and frameworks in the ecosystem

# TypeScript compilation output (if TypeScript is added later)
*.tsbuildinfo

# ESLint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# =============================================================================
# PROJECT-SPECIFIC IGNORES
# =============================================================================
# Application-specific files that may be generated during development
# or contain local development data

# Local development database files (if SQLite is used)
*.sqlite
*.sqlite3
*.db

# Local uploads directory (if file uploads are implemented)
uploads/
public/uploads/

# =============================================================================
# END OF .GITIGNORE
# =============================================================================
# This .gitignore file should be reviewed and updated whenever new tools,
# build steps, or configuration files are introduced to the project.
# 
# Security Reminder: Always verify that sensitive files (especially .env files)
# are properly ignored before committing. Use 'git status' to check for any
# untracked files that should be ignored.
#
# For verification: Run 'git status' after generating build artifacts,
# installing dependencies, or creating .env files to ensure these files
# are not shown as untracked or modified.
# =============================================================================