# Dependencies
# Prevents tracking of installed dependencies managed by npm
node_modules/

# NPM and Yarn Debug/Error Logs
# Ignores debug and error logs generated by package managers
npm-debug.log
yarn-debug.log
yarn-error.log

# Environment Configuration Files
# Prevents sensitive environment variables from being committed
.env
# Ignores all environment-specific .env files (e.g., .env.development, .env.production)
.env.*

# Test Coverage Reports
# Ignores code coverage output from test runs
coverage/

# Build Output
# Ignores build output directory if present
dist/

# Application Logs
# Ignores application log files and log directories
logs/
*.log

# Package Lock File (Optional)
# Optionally ignored in some workflows, but typically tracked; may be ignored in some setups
package-lock.json

# TypeScript Build Info
# Ignores TypeScript incremental build info files
*.tsbuildinfo

# Operating System Files
# Ignores macOS Finder metadata files
.DS_Store
# Ignores Windows Explorer metadata files
Thumbs.db

# IDE and Editor Files
# Common IDE and editor temporary files
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime Files
# Process ID files
*.pid
*.seed
*.pid.lock

# Temporary Files
# System temporary files
.tmp/
temp/

# Cache Directories
# Various cache directories
.cache/
.eslintcache
.nyc_output/

# Optional NPM Cache Directory
.npm

# Optional ESLINT Cache
.eslintcache

# Microbundle Cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL History
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity File
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*