# Node.js Tutorial Application - Git Ignore Configuration
# Generated for Express.js 5.1.0 application with Jest testing and Docker support
# Excludes dependencies, environment variables, build artifacts, and development files

# =============================================================================
# DEPENDENCIES AND PACKAGE MANAGEMENT
# =============================================================================
# NPM and Node.js dependency management files and debug logs
# node_modules contains thousands of dependency files that should be installed
# locally via package.json and are not tracked in version control

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# =============================================================================
# ENVIRONMENT VARIABLES AND CONFIGURATION
# =============================================================================
# Environment variable files containing sensitive configuration data
# Environment files contain sensitive data like API keys, database credentials,
# and environment-specific settings that should not be committed to version control

.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
config/local.js
config/local-*.js

# =============================================================================
# TEST COVERAGE AND ARTIFACTS
# =============================================================================
# Jest test coverage reports and testing artifacts
# Test coverage reports and artifacts are generated during test execution
# and should not be committed as they vary by environment and test run

coverage/
coverage.*
*.lcov
.coverage
test-results/
test-reports/
junit.xml
test-output/
.jest-cache/

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
# Application logs, temporary files, and process identifier files
# Log files and temporary files are runtime artifacts that contain
# environment-specific data and should be generated locally rather than tracked

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
.tmp/
*.tmp
*.temp
pids/
*.pid
*.seed
*.pid.lock

# =============================================================================
# CACHE DIRECTORIES AND BUILD TOOLS
# =============================================================================
# Various tool caches and build optimization directories
# Cache directories improve build performance but are specific to each
# development environment and should be regenerated locally

.cache/
.npm/
.eslintcache
.node_repl_history
.nyc_output/
.jest/
node_modules/.cache/
.parcel-cache/
.vscode-test/
.wireit/

# =============================================================================
# IDE AND EDITOR FILES
# =============================================================================
# IDE and text editor configuration files and temporary files
# IDE configurations are personal preferences and temporary editor files
# should not be shared across development team members

.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace
.history/
.ionide/

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================
# Operating system generated files and directories
# OS-specific files are generated by file systems and should not be tracked
# as they are not related to the application functionality

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =============================================================================
# BUILD AND DISTRIBUTION ARTIFACTS
# =============================================================================
# Build outputs, distribution packages, and compiled artifacts
# Build outputs are generated from source code and should be created during
# deployment rather than stored in version control

dist/
build/
out/
.next/
.nuxt/
*.tgz
*.tar.gz
*.zip
lib-cov/
.grunt/

# =============================================================================
# DOCKER AND CONTAINER FILES
# =============================================================================
# Docker-specific temporary files and environment overrides
# Docker environment-specific overrides and temporary build files should
# remain local to each development environment

*.dockerignore
.docker/
docker-compose.override.yml
.dockerfile*

# =============================================================================
# SECURITY AND CERTIFICATES
# =============================================================================
# SSL certificates, private keys, and security credentials
# Security certificates and private keys must never be committed to
# version control for security reasons

*.pem
*.key
*.cert
*.crt
*.csr
*.pfx
*.p12
.certificates/

# =============================================================================
# PERFORMANCE AND MONITORING
# =============================================================================
# Performance profiling data and monitoring artifacts
# Profiling data is environment-specific and often contains sensitive
# performance information that should not be shared

*.cpuprofile
*.heapsnapshot
.clinic/
profile/
flame-graph.html
*.trace