# =============================================================================
# Node.js Tutorial Application Environment Configuration
# =============================================================================
# This file contains environment-specific configuration values for the 
# Node.js tutorial application built with Express.js 5.1.0 and Node.js v22.x LTS.
#
# IMPORTANT SECURITY NOTES:
# - This file should be listed in .gitignore to prevent accidental commits
# - Contains environment-specific configuration that should not be shared
# - Use .env.example for documenting expected environment variables
# - Set restricted file permissions (e.g., 600) on production systems
#
# USAGE INSTRUCTIONS:
# 1. Copy .env.example to .env in the same directory
# 2. Uncomment and modify values as needed for your environment
# 3. Restart the application after changing environment variables
# 4. Never commit .env files containing sensitive information to version control
# 5. Use different .env files for different environments (dev/test/prod)
# =============================================================================

# =============================================================================
# APPLICATION INFORMATION
# =============================================================================
# Name identifier for the tutorial application, used in logging and monitoring
# Validation: String value, alphanumeric with hyphens allowed
# Usage: Used by logging system for application identification in log output
APPLICATION_NAME=nodejs-hello-tutorial

# Version identifier for the tutorial application following semantic versioning
# Validation: Semantic versioning format (MAJOR.MINOR.PATCH)
# Usage: Used for application identification and deployment tracking
APPLICATION_VERSION=1.0.0

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# HTTP server port number for accepting incoming connections
# Validation: Integer between 1 and 65535, ports below 1024 require elevated privileges
# Usage: Configures the port where the Express.js HTTP server listens for requests
# Common customization: Change PORT to avoid conflicts with other local services
PORT=3000

# HTTP server host address for binding the network interface
# Validation: Valid hostname or IP address (IPv4 or IPv6)
# Usage: Configures the host interface where the server binds for network connections
# Security: localhost recommended for development security
# Network access: Set to 0.0.0.0 for network access from other machines
HOST=localhost

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Node.js environment mode that affects application behavior and optimizations
# Validation: Must be one of: development, test, production
# Usage: Controls Express.js optimizations, logging behavior, and error handling verbosity
# Development: Enables development-specific features and detailed error messages
# Production: Optimizes performance and reduces logging verbosity
NODE_ENV=development

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Minimum logging level for console output, controls verbosity of application logs
# Validation: Must be one of: ERROR, WARN, INFO, DEBUG (case sensitive)
# Usage: Configures the minimum level of log messages that will be output to console
# INFO: Normal operation events (server startup, request processing)
# WARN: Recoverable error conditions (port conflicts, configuration issues)
# ERROR: System failures requiring attention (startup failures, handler exceptions)
# DEBUG: Detailed execution flow for development troubleshooting
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT TOOLS (OPTIONAL)
# =============================================================================
# Debug namespace pattern for enabling detailed debugging output from specific modules
# Validation: Comma-separated list of debug patterns, supports wildcards
# Usage: Enables detailed debugging output following the 'debug' module pattern for development
# Example patterns: tutorial:*, tutorial:server, tutorial:routes
# Leave empty to disable debug output
DEBUG=

# =============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES AND TROUBLESHOOTING
# =============================================================================
#
# DEVELOPMENT ENVIRONMENT EXAMPLE:
# NODE_ENV=development
# LOG_LEVEL=DEBUG
# HOST=localhost
# PORT=3000
# DEBUG=tutorial:*
#
# TEST ENVIRONMENT EXAMPLE:
# NODE_ENV=test
# LOG_LEVEL=ERROR
# HOST=localhost
# PORT=0
# DEBUG=
#
# PRODUCTION ENVIRONMENT EXAMPLE:
# NODE_ENV=production
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=${PORT}
# DEBUG=
#
# COMMON TROUBLESHOOTING:
# - Port already in use: Change PORT to an available port number (e.g., PORT=3001)
# - Cannot bind to host: Verify HOST is valid and accessible (e.g., HOST=127.0.0.1)
# - Too much log output: Increase LOG_LEVEL to reduce verbosity (e.g., LOG_LEVEL=WARN)
# - Application behavior differs: Verify NODE_ENV matches intended environment
#
# CONFIGURATION VALIDATION:
# Environment variables are validated by scripts/validate-env.js before application startup
# Configuration precedence: Environment variables override default values in config modules
# Integration: Variables loaded by config/environment.js during application startup
# =============================================================================