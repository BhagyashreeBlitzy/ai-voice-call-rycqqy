# =============================================================================
# Node.js Tutorial Application - Environment Configuration
# =============================================================================
# 
# This file contains environment variables for the Node.js/Express tutorial
# application. It demonstrates proper configuration management patterns and
# provides flexibility for different deployment scenarios.
# 
# IMPORTANT SECURITY NOTES:
# - This file should NOT be committed to version control if it contains sensitive data
# - Create a .env.example file as a template for required variables
# - Use different .env files for different environments (development, staging, production)
# - Ensure proper file permissions (readable only by application owner)
# 
# Compatible with dotenv library for automatic environment variable loading
# Usage: require('dotenv').config() in your Node.js application
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Primary server port configuration
# Requirement: F-004-RQ-001 - Environment-based port configuration
# The server will use the PORT environment variable or default to 3000
# This enables easy port customization and demonstrates configuration best practices
# Valid range: 1024-65535 (non-privileged ports)
# Cloud platforms (Heroku, Railway, etc.) will override this value
PORT=3000

# Alternative port for development server instances
# Useful when running multiple instances for testing or development
# DEV_PORT=3001

# Server host binding
# For local development, typically localhost or 127.0.0.1
# For production, use 0.0.0.0 to accept connections from all interfaces
# Security: Be cautious with 0.0.0.0 in production environments
HOST=localhost

# =============================================================================
# NODE.JS RUNTIME CONFIGURATION
# =============================================================================

# Node.js environment setting
# Requirement: F-004 - Server Configuration Management
# Valid values: development, test, production
# This affects Express behavior, logging levels, and error handling
# Express 5.1.0 uses this for automatic security and performance optimizations
NODE_ENV=development

# Node.js debugging configuration
# Enables detailed debugging output for development
# Use 'app:*' to debug application-specific components
# Use 'express:*' to debug Express framework components
# Leave empty or comment out for production
DEBUG=

# Node.js memory limit (in MB)
# Useful for preventing memory issues in constrained environments
# Educational value: demonstrates resource management awareness
# NODE_OPTIONS=--max-old-space-size=512

# =============================================================================
# EXPRESS FRAMEWORK CONFIGURATION
# =============================================================================

# Express trust proxy setting
# Important for applications behind reverse proxies (nginx, load balancers)
# Valid values: true, false, IP addresses, subnets
# Required for proper client IP detection and security headers
TRUST_PROXY=false

# Express session secret (for future expansion)
# SECURITY: Generate a strong, random secret for production
# This is for educational purposes - tutorial app doesn't use sessions
# SESSION_SECRET=your-super-secret-key-here

# Request timeout in milliseconds
# Prevents hanging requests and improves server stability
# Educational value: demonstrates timeout handling best practices
REQUEST_TIMEOUT=30000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS (Cross-Origin Resource Sharing) settings
# Important for web applications that serve APIs
# Educational value: demonstrates web security concepts
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=false

# Rate limiting configuration
# Prevents abuse and demonstrates security best practices
# Values are requests per window (in minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security headers configuration
# Enables/disables various security headers
# Educational value: introduces web security concepts
SECURITY_HEADERS_ENABLED=true

# Content Security Policy (CSP) settings
# Prevents XSS attacks and other injection vulnerabilities
# Educational value: demonstrates modern web security practices
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self' 'unsafe-inline'

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level configuration
# Valid values: error, warn, info, debug, verbose
# Controls the verbosity of application logging
# Educational value: demonstrates logging best practices
LOG_LEVEL=info

# Log format configuration
# Valid values: combined, common, dev, short, tiny
# For educational purposes, 'dev' provides colored output
LOG_FORMAT=dev

# Enable request logging
# Logs all HTTP requests for debugging and monitoring
# Educational value: demonstrates request tracking
LOG_REQUESTS=true

# Log file location (if file logging is enabled)
# Useful for production deployments and log aggregation
# LOG_FILE=./logs/app.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development server auto-reload
# Works with nodemon for automatic server restarts
# Educational value: improves development workflow
AUTO_RELOAD=true

# Development error handling
# Shows detailed error information in development
# SECURITY: Should be false in production
DETAILED_ERRORS=true

# Development response caching
# Disables caching for development to see changes immediately
# Educational value: demonstrates caching concepts
DISABLE_CACHE=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable gzip compression
# Reduces response size and improves performance
# Educational value: demonstrates performance optimization
ENABLE_COMPRESSION=true

# Static file caching (in seconds)
# Controls how long browsers cache static assets
# Educational value: demonstrates caching strategies
STATIC_CACHE_MAX_AGE=86400

# Keep-alive timeout (in milliseconds)
# Optimizes connection reuse for better performance
# Educational value: demonstrates HTTP connection management
KEEP_ALIVE_TIMEOUT=5000

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Health check endpoint configuration
# Enables application health monitoring
# Educational value: demonstrates operational best practices
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Application metrics collection
# Enables basic performance metrics collection
# Educational value: introduces application monitoring concepts
METRICS_ENABLED=false

# Request ID generation
# Enables request tracking across distributed systems
# Educational value: demonstrates distributed system concepts
GENERATE_REQUEST_ID=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Application version
# Useful for deployment tracking and debugging
# Educational value: demonstrates version management
APP_VERSION=1.0.0

# Application name
# Used for logging and monitoring identification
# Educational value: demonstrates application identification
APP_NAME=nodejs-tutorial-app

# Deployment environment
# Distinguishes between different deployment stages
# Educational value: demonstrates environment management
DEPLOYMENT_ENV=local

# Build timestamp (automatically set during deployment)
# Useful for deployment verification and debugging
# BUILD_TIMESTAMP=

# =============================================================================
# PLATFORM-SPECIFIC CONFIGURATION
# =============================================================================

# Cross-platform compatibility settings
# Requirement: Platform Compatibility - Windows, macOS, Linux support
# These settings ensure consistent behavior across different operating systems

# Path separator handling (Node.js handles this automatically)
# Educational value: demonstrates cross-platform considerations
# PLATFORM_AWARE_PATHS=true

# Process management configuration
# Handles graceful shutdown across different platforms
# Educational value: demonstrates proper process lifecycle management
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# File system watching (for development)
# Platform-specific file watching configuration
# Educational value: demonstrates platform-aware development
FS_WATCH_POLLING=false

# =============================================================================
# EDUCATIONAL CONFIGURATION
# =============================================================================

# Enable educational features
# Provides additional logging and debugging information for learning
# Educational value: demonstrates feature toggling
EDUCATIONAL_MODE=true

# Verbose startup logging
# Shows detailed information during application startup
# Educational value: demonstrates application initialization
VERBOSE_STARTUP=true

# Show configuration on startup
# Displays loaded configuration (without sensitive values)
# Educational value: demonstrates configuration validation
SHOW_CONFIG=true

# =============================================================================
# FUTURE EXPANSION VARIABLES
# =============================================================================

# Database configuration (for future tutorials)
# Currently not used but demonstrates database configuration patterns
# DATABASE_URL=
# DATABASE_NAME=tutorial_db
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# Redis configuration (for future caching tutorials)
# Currently not used but demonstrates caching configuration patterns
# REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email configuration (for future notification tutorials)
# Currently not used but demonstrates email configuration patterns
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# This .env file is configured for the Node.js tutorial application
# Requirements addressed:
# - F-004-RQ-001: Environment-based port configuration
# - Server Configuration Management (F-004)
# - Cross-platform compatibility (Windows, macOS, Linux)
# - Security best practices and educational value
# - Production-ready configuration patterns
# - Express 5.1.0 compatibility and security enhancements
# - Comprehensive documentation for learning purposes

# For production deployments:
# 1. Create environment-specific .env files
# 2. Use secure secret management systems
# 3. Enable appropriate security headers
# 4. Configure proper logging and monitoring
# 5. Set NODE_ENV=production
# 6. Use HTTPS and proper SSL/TLS configuration
# 7. Enable rate limiting and security middleware
# 8. Configure proper CORS settings for your domain

# Remember: This file demonstrates configuration best practices for educational
# purposes. Real production applications should use proper secret management
# and environment-specific configuration strategies.