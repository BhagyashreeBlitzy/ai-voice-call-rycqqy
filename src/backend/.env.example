# =============================================================================
# Node.js Tutorial Backend - Environment Configuration Template
# =============================================================================
# 
# This file serves as a template for environment variables required by the
# Node.js tutorial backend application. Copy this file to .env in the same
# directory and adjust values as needed for your local or deployment environment.
#
# The application uses Express 5.1.0 with Node.js 22.x LTS and follows
# environment-based configuration management best practices.
#
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# The environment in which the application runs
# Valid values: development, production, test
# - development: Enables debug logging, detailed error messages, and development tools
# - production: Optimized for performance, minimal logging, secure error handling
# - test: Configured for automated testing with test-specific settings
#
# Default: development (if not specified)
# Configuration managed by: F-004 Server Configuration Management
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# The port number for the HTTP server
# Must be an integer between 1024 and 65535
# Ports below 1024 are reserved for system services and require elevated privileges
# Common development ports: 3000, 8000, 8080
# Common production ports: 80 (HTTP), 443 (HTTPS), 8000, 8080
#
# Default: 3000 (if not specified)
# Requirement: F-004-RQ-001 Environment-based port configuration
# Validation: Integer within range 1024-65535, port must be available
PORT=3000

# -----------------------------------------------------------------------------
# MONITORING AND OBSERVABILITY CONFIGURATION
# -----------------------------------------------------------------------------

# Enable or disable application monitoring features
# Valid values: true, false
# When enabled, exposes health check endpoints and performance metrics
# Used by monitoring utilities, logging systems, and health checks
#
# Default: true in development, false in production (for security)
# Requirement: 5.4.1 Monitoring and Observability Approach
ENABLE_MONITORING=true

# Log level for application logging
# Valid values: debug, info, warn, error, critical
# - debug: Detailed debugging information for development
# - info: General information about application operation
# - warn: Warning messages for potential issues
# - error: Error messages for application failures
# - critical: Critical system errors requiring immediate attention
#
# Default: info (if not specified)
# Used by: Express middleware, error handlers, and monitoring systems
LOG_LEVEL=info

# Health check endpoint configuration
# Valid values: true, false
# When enabled, provides /health, /ready, and /status endpoints
# Used by: Load balancers, Kubernetes probes, monitoring systems
#
# Default: true (recommended for all environments)
# Integration: 5.4.1 Monitoring and Observability Approach
ENABLE_HEALTH_CHECKS=true

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------

# Enable security headers and middleware
# Valid values: true, false
# When enabled, adds security headers like X-Content-Type-Options, X-Frame-Options
# Recommended for production environments
#
# Default: true in production, false in development
# Security: Express 5.1.0 security enhancements, ReDoS protection
ENABLE_SECURITY_HEADERS=false

# Enable request rate limiting
# Valid values: true, false
# When enabled, implements basic rate limiting for API endpoints
# Helps prevent abuse and DoS attacks
#
# Default: false in development, true in production
# Security: 6.5.1 Security-First Design approach
ENABLE_RATE_LIMITING=false

# -----------------------------------------------------------------------------
# PERFORMANCE CONFIGURATION
# -----------------------------------------------------------------------------

# Enable response compression
# Valid values: true, false
# When enabled, compresses HTTP responses to reduce bandwidth usage
# Recommended for production environments
#
# Default: false in development, true in production
# Performance: Express 5.1.0 performance optimizations
ENABLE_COMPRESSION=false

# Request timeout in milliseconds
# Must be a positive integer
# Maximum time to wait for request processing before timing out
# Prevents hanging requests from consuming resources
#
# Default: 30000 (30 seconds)
# Performance: 5.4.6 Performance Requirements and SLAs
REQUEST_TIMEOUT=30000

# -----------------------------------------------------------------------------
# DEVELOPMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Enable development mode features
# Valid values: true, false
# When enabled, provides additional debugging information and development tools
# Should be disabled in production for security and performance
#
# Default: true in development, false in production
# Development: Enhanced debugging and development experience
ENABLE_DEV_MODE=true

# Enable detailed error messages in responses
# Valid values: true, false
# When enabled, includes stack traces and detailed error information
# Should be disabled in production to prevent information disclosure
#
# Default: true in development, false in production
# Security: Error handling security measures
ENABLE_DEBUG_ERRORS=true

# Enable automatic server restart on file changes
# Valid values: true, false
# When enabled, restarts the server automatically when source files change
# Useful for development but not applicable in production
#
# Default: false (requires external tools like nodemon)
# Development: Development workflow optimization
ENABLE_AUTO_RESTART=false

# -----------------------------------------------------------------------------
# FUTURE CONFIGURATION PLACEHOLDERS
# -----------------------------------------------------------------------------

# Database connection string (placeholder for future database integration)
# Format: protocol://username:password@host:port/database
# Example: mongodb://localhost:27017/tutorial_db
# DATABASE_URL=

# Redis connection string (placeholder for future caching integration)
# Format: redis://username:password@host:port/database
# Example: redis://localhost:6379/0
# REDIS_URL=

# API key for external services (placeholder for future API integrations)
# Format: alphanumeric string
# Example: sk-1234567890abcdef
# API_KEY=

# SMTP configuration (placeholder for future email functionality)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# JWT secret for authentication (placeholder for future auth implementation)
# Should be a strong, random string of at least 32 characters
# JWT_SECRET=

# Session secret for session management (placeholder for future session handling)
# Should be a strong, random string of at least 32 characters
# SESSION_SECRET=

# -----------------------------------------------------------------------------
# CONFIGURATION VALIDATION NOTES
# -----------------------------------------------------------------------------

# The application will validate these values at startup:
# 1. PORT must be a valid integer within the range 1024-65535
# 2. ENVIRONMENT must be one of: development, production, test
# 3. Boolean values must be: true, false (case-insensitive)
# 4. Numeric values must be valid integers within specified ranges
# 5. String values will be validated against allowed patterns where applicable
#
# If validation fails, the application will:
# - Log validation errors with detailed information
# - Fall back to sensible defaults where possible
# - Exit with error code 1 for critical configuration issues
#
# For more information on configuration requirements, see:
# - Technical Specification Section 2.1.4: Application Configuration
# - Technical Specification Section 2.2.4: Server Configuration Management
# - Technical Specification Section 5.4.1: Monitoring and Observability

# =============================================================================
# END OF CONFIGURATION TEMPLATE
# =============================================================================