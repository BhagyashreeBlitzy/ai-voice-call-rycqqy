# ==============================================================================
# Node.js Tutorial Application Environment Variables Template
# ==============================================================================
#
# This file provides example configuration values for the Node.js v22.11.0 LTS
# tutorial application using Express.js v5.1.0 framework.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to create your own configuration: cp .env.example .env
# 2. Edit the .env file with your specific configuration values
# 3. Ensure .env file is added to .gitignore to prevent committing sensitive data
# 4. Restart the application after making changes to environment variables
#
# VALIDATION RULES:
# - PORT must be a valid port number between 1 and 65535
# - HOST must be a valid hostname or IP address
# - LOG_LEVEL must be one of: error, warn, info, debug
# - Boolean values must be 'true' or 'false' (lowercase)
# - Timeout values must be positive integers in milliseconds
#
# ==============================================================================

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# Application runtime environment
# Valid values: development, production, test
# Default: development
# Usage: Determines which configuration file to load and affects logging,
#        security, and performance settings
NODE_ENV=development

# HTTP server listening port
# Valid values: 1-65535
# Default: 3000
# Usage: Port number for the HTTP server to listen on, commonly 3000 for 
#        development, 8080 for production
PORT=3000

# Server host binding address
# Valid values: Valid hostname or IP address
# Default: localhost
# Usage: Host address to bind the server to, use 'localhost' for development,
#        '0.0.0.0' for production containers
HOST=localhost

# Request timeout in milliseconds
# Valid values: Positive integer
# Default: 30000
# Usage: Maximum time to wait for a request to complete before timing out
TIMEOUT=30000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Logging verbosity level
# Valid values: error, warn, info, debug
# Default: info
# Usage: Controls which log messages are output, 'error' for minimal logging,
#        'debug' for verbose logging
LOG_LEVEL=info

# Enable debug mode for verbose logging
# Valid values: true, false
# Default: false
# Usage: When enabled, provides additional debugging information and verbose
#        logging output
DEBUG=false

# Enable verbose logging output
# Valid values: true, false
# Default: false
# Usage: Enables detailed logging including request/response details and
#        performance metrics
VERBOSE=false

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================

# Enable proxy trust for accurate client IP detection
# Valid values: true, false, 1, loopback
# Default: false
# Usage: Set to true when running behind a reverse proxy like nginx or
#        load balancer
TRUST_PROXY=false

# Enable request rate limiting for DDoS protection
# Valid values: true, false
# Default: false
# Usage: Enables rate limiting middleware to prevent abuse, typically enabled
#        in production
RATE_LIMIT_ENABLED=false

# Enable security headers middleware
# Valid values: true, false
# Default: false
# Usage: Enables helmet.js security headers for production security hardening
HELMET_ENABLED=false

# Enable Content Security Policy headers
# Valid values: true, false
# Default: false
# Usage: Enables strict Content Security Policy headers for XSS protection
CSP_ENABLED=false

# CORS allowed origins configuration
# Valid values: URL or '*' for all origins
# Default: *
# Usage: Specifies allowed origins for CORS requests, use specific URLs in
#        production
CORS_ORIGIN=*

# ==============================================================================
# MONITORING CONFIGURATION
# ==============================================================================

# Enable application metrics collection
# Valid values: true, false
# Default: false
# Usage: Enables Prometheus metrics collection for monitoring and observability
ENABLE_METRICS=false

# Health check timeout in milliseconds
# Valid values: Positive integer
# Default: 5000
# Usage: Maximum time for health check endpoints to respond before marking
#        as unhealthy
HEALTH_CHECK_TIMEOUT=5000

# ==============================================================================
# FEATURE CONFIGURATION
# ==============================================================================

# Enable the /hello endpoint
# Valid values: true, false
# Default: true
# Usage: Controls whether the main /hello tutorial endpoint is enabled
HELLO_ENDPOINT=true

# Enable health check endpoints
# Valid values: true, false
# Default: true
# Usage: Controls whether health check endpoints (/health, /readyz, /livez)
#        are enabled
HEALTH_ENDPOINTS=true

# Enable response compression
# Valid values: true, false
# Default: false
# Usage: Enables gzip compression for HTTP responses to improve performance
COMPRESSION_ENABLED=false

# ==============================================================================
# PRODUCTION OVERRIDES
# ==============================================================================

# Production-specific port override
# Valid values: 1-65535
# Default: 8080
# Usage: Port number specifically for production deployment, takes precedence
#        over PORT in production
PROD_PORT=8080

# Production-specific host override
# Valid values: Valid hostname or IP address
# Default: 0.0.0.0
# Usage: Host binding specifically for production, typically 0.0.0.0 for
#        container deployment
PROD_HOST=0.0.0.0

# ==============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# ==============================================================================

# DEVELOPMENT ENVIRONMENT EXAMPLE:
# NODE_ENV=development
# PORT=3000
# HOST=localhost
# LOG_LEVEL=debug
# DEBUG=true
# VERBOSE=true
# TRUST_PROXY=false
# ENABLE_METRICS=false

# PRODUCTION ENVIRONMENT EXAMPLE:
# NODE_ENV=production
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=warn
# DEBUG=false
# TRUST_PROXY=true
# RATE_LIMIT_ENABLED=true
# HELMET_ENABLED=true
# CSP_ENABLED=true
# ENABLE_METRICS=true

# TEST ENVIRONMENT EXAMPLE:
# NODE_ENV=test
# PORT=0
# HOST=localhost
# LOG_LEVEL=error
# DEBUG=false
# VERBOSE=false

# ==============================================================================
# INTEGRATION INFORMATION
# ==============================================================================

# These environment variables are used by:
# - src/backend/src/utils/config.js: Configuration management system
# - src/backend/src/server.js: HTTP server setup
# - src/backend/src/app.js: Express app configuration
# - src/backend/src/utils/logger.js: Log level management
# - Middleware components: Security and feature configuration

# ==============================================================================
# SECURITY CONSIDERATIONS
# ==============================================================================

# IMPORTANT SECURITY NOTES:
# - This example file contains no sensitive information
# - Actual .env files should not be committed to version control
# - Use strong, unique values in production environments
# - Restrict access to .env files in production deployment
# - All environment variable values are validated by the configuration system

