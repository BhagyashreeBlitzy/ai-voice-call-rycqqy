# Example environment variables for Node.js Tutorial Backend
# Copy this file to .env and adjust values as needed for your environment.
# 
# This file serves as a template for all environment variables used by the backend server.
# All variables are optional and have sensible defaults, but can be overridden for 
# local development, testing, or production deployment.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# The port the HTTP server will listen on
# Must be between 1024 and 65535 (avoiding privileged ports)
# Default: 3000 (standard development port for Node.js applications)
PORT=3000

# The Node.js environment setting
# Controls Express.js behavior, logging verbosity, and error handling patterns
# Valid values: development, production, test
# Default: development
NODE_ENV=development

# HTTP request timeout in milliseconds
# Prevents hanging connections and resource exhaustion
# Value must be a positive integer
# Default: 30000 (30 seconds)
REQUEST_TIMEOUT_MS=30000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Log level for the application logger
# Controls which log messages are output based on severity
# Valid values: info, warn, error
# Default: info
LOG_LEVEL=info

# ==============================================================================
# USAGE INSTRUCTIONS
# ==============================================================================
# 
# 1. Copy this file to .env in the project root:
#    cp .env.example .env
# 
# 2. Adjust the values as needed for your environment:
#    - For local development: defaults are usually sufficient
#    - For production: set NODE_ENV=production and adjust PORT as needed
#    - For testing: set NODE_ENV=test and LOG_LEVEL=warn
# 
# 3. The application will read these variables at startup via process.env
#    and validate them using the configuration logic in config/server.js
# 
# 4. Invalid values will result in warnings and fallback to defaults,
#    except for PORT which must be within the valid range (1024-65535)
# 
# ==============================================================================
# EXAMPLES FOR DIFFERENT ENVIRONMENTS
# ==============================================================================
#
# Development (default):
# PORT=3000
# NODE_ENV=development
# REQUEST_TIMEOUT_MS=30000
# LOG_LEVEL=info
#
# Production:
# PORT=8080
# NODE_ENV=production
# REQUEST_TIMEOUT_MS=60000
# LOG_LEVEL=warn
#
# Testing:
# PORT=3001
# NODE_ENV=test
# REQUEST_TIMEOUT_MS=10000
# LOG_LEVEL=error