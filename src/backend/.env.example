# ================================================================
# Node.js Tutorial Application - Environment Configuration Template
# ================================================================
#
# This file serves as a template for environment variable configuration.
# Copy this file to '.env' in the same directory and customize values
# for your local development environment.
#
# IMPORTANT SECURITY NOTES:
# - Never commit .env files to version control
# - Use .env.example for documenting required variables
# - Keep sensitive data out of environment files in production
#
# For more information about Node.js environment variables:
# https://nodejs.org/api/process.html#process_process_env
#

# ================================================================
# APPLICATION INFORMATION
# ================================================================
#
# Application name for logging and identification
# Used by logging system for application identification in output
APPLICATION_NAME=nodejs-hello-tutorial
#
# Application version following semantic versioning (MAJOR.MINOR.PATCH)
# Used for deployment tracking and application identification
APPLICATION_VERSION=1.0.0

# ================================================================
# SERVER CONFIGURATION
# ================================================================
#
# HTTP server port number (1-65535)
# Default: 3000 (change if port is already in use)
# Avoid ports below 1024 in development (require elevated privileges)
PORT=3000
#
# HTTP server host address for network binding
# Default: localhost (recommended for development security)
# Use 0.0.0.0 to allow connections from other machines
HOST=localhost

# ================================================================
# ENVIRONMENT CONFIGURATION
# ================================================================
#
# Node.js environment mode (affects Express.js behavior)
# Values: development, test, production
# - development: Enhanced debugging, detailed error messages
# - test: Minimal logging, optimized for testing
# - production: Optimized performance, security headers
NODE_ENV=development

# ================================================================
# LOGGING CONFIGURATION
# ================================================================
#
# Minimum logging level for console output
# Values: ERROR, WARN, INFO, DEBUG (case sensitive)
# - ERROR: Only critical errors and failures
# - WARN: Warnings and recoverable issues
# - INFO: General application information (recommended)
# - DEBUG: Detailed debugging information (development only)
LOG_LEVEL=INFO

# ================================================================
# DEVELOPMENT TOOLS (OPTIONAL)
# ================================================================
#
# Debug namespace patterns for detailed module debugging
# Uncomment and customize for development debugging:
# DEBUG=tutorial:*          # All tutorial modules
# DEBUG=tutorial:server     # Server-specific debugging
# DEBUG=tutorial:routes     # Route handling debugging
# DEBUG=express:*           # Express.js framework debugging
# DEBUG=*                   # All modules (very verbose)
#
# Example for tutorial application debugging:
# DEBUG=tutorial:*

# ================================================================
# USAGE INSTRUCTIONS
# ================================================================
#
# 1. Copy this file: cp .env.example .env
# 2. Customize values above for your environment
# 3. Restart the application after making changes
# 4. Use 'npm run validate' to check configuration
#
# Environment-specific examples:
#
# Development (detailed logging, local access):
# NODE_ENV=development
# LOG_LEVEL=DEBUG
# HOST=localhost
# PORT=3000
# DEBUG=tutorial:*
#
# Production (optimized, secure):
# NODE_ENV=production
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=${PORT}  # From environment or process manager
#
# Testing (minimal output):
# NODE_ENV=test
# LOG_LEVEL=ERROR
# HOST=localhost
# PORT=0  # Random available port
#
# ================================================================