{
  "watch": [
    "app.js",
    "server.js",
    "routes/",
    "middleware/",
    "utils/",
    "config/"
  ],
  "ext": "js,json",
  "ignore": [
    "tests/",
    "docs/",
    "scripts/",
    "node_modules/",
    "*.test.js",
    "*.spec.js",
    "*.md"
  ],
  "exec": "node server.js",
  "env": {
    "NODE_ENV": "development",
    "PORT": "3000"
  },
  "delay": "100",
  "legacyWatch": false,
  "verbose": true
}