{
  "watch": [
    "app.js",
    "index.js",
    "config/",
    "controllers/",
    "routes/",
    "middleware/",
    "utils/"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/",
    "logs/",
    "coverage/",
    "__tests__/",
    "Dockerfile",
    "docker-compose.yml",
    "*.test.js"
  ],
  "exec": "node --experimental-specifier-resolution=node --trace-warnings app.js",
  "env": {
    "NODE_ENV": "development",
    "PORT": "3000"
  },
  "delay": "200",
  "legacyWatch": false,
  "verbose": true,
  "signal": "SIGTERM"
}