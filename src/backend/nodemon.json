{
  "watch": [
    "src/",
    "config/",
    "bin/",
    "server.js",
    "app.js"
  ],
  "ext": "js,json,mjs",
  "ignore": [
    "test/",
    "coverage/",
    "logs/",
    "tmp/",
    "node_modules/",
    "*.test.js",
    "*.spec.js",
    ".git/",
    ".github/",
    "docs/",
    "infrastructure/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exec": "node src/server.js",
  "env": {
    "NODE_ENV": "development",
    "PORT": "3000",
    "HOST": "localhost",
    "LOG_LEVEL": "debug",
    "DEBUG": "true",
    "VERBOSE": "true"
  },
  "delay": 2000,
  "verbose": true,
  "legacyWatch": false,
  "polling": false,
  "quiet": false,
  "inspect": false,
  "inspectBrk": false,
  "colours": true,
  "restartable": "rs",
  "stdout": true,
  "stdin": true,
  "runOnChangeOnly": false,
  "signal": "SIGUSR2",
  "cwd": "./",
  "nodeArgs": []
}