{
  "name": "nodejs-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial backend demonstrating a production-ready Express.js server with a /hello endpoint.",
  "main": "app.js",
  "scripts": {
    "start": "node ./scripts/start.js",
    "dev": "nodemon --config ./nodemon.json ./scripts/dev.js",
    "test": "node ./scripts/test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "node -e \"console.log('Server health check'); process.exit(0)\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.0.0",
    "http-errors": "^2.0.0",
    "on-finished": "^2.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^7.1.1",
    "node-mocks-http": "^1.11.0",
    "eslint": "^8.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-jest": "^27.0.0",
    "eslint-plugin-jsdoc": "^46.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <23.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "backend",
    "http-server",
    "rest-api",
    "javascript",
    "educational"
  ],
  "author": "Tutorial Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutorial/nodejs-tutorial-backend.git"
  },
  "bugs": {
    "url": "https://github.com/tutorial/nodejs-tutorial-backend/issues"
  },
  "homepage": "https://github.com/tutorial/nodejs-tutorial-backend#readme",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}