{
  "name": "nodejs-hello-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial application backend demonstrating HTTP server fundamentals with Express.js 5.1.0 and a single /hello endpoint returning Hello world response for educational purposes",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "engineStrict": true,
  "preferGlobal": false,
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Tutorial Author",
    "email": "tutorial@example.com"
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "http-server",
    "backend",
    "educational",
    "hello-world",
    "web-development"
  ],
  "homepage": "https://github.com/tutorial/nodejs-hello-tutorial#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutorial/nodejs-hello-tutorial.git",
    "directory": "src/backend"
  },
  "bugs": {
    "url": "https://github.com/tutorial/nodejs-hello-tutorial/issues"
  },
  "scripts": {
    "start": "node bin/www",
    "dev": "node scripts/dev.js",
    "server": "node scripts/start.js",
    "test": "node scripts/test.js",
    "test:unit": "node scripts/test.js --type=unit",
    "test:integration": "node scripts/test.js --type=integration",
    "test:e2e": "node scripts/test.js --type=e2e",
    "test:watch": "node scripts/test-watch.js",
    "test:coverage": "node scripts/test-coverage.js",
    "test:all": "node scripts/test.js --type=all --coverage",
    "validate": "node scripts/validate-env.js",
    "health": "node scripts/health-check.js",
    "lint": "echo 'Linting not configured for tutorial simplicity'",
    "clean": "echo 'Clean not required for tutorial application'",
    "build": "echo 'Build not required - Node.js runtime application'",
    "prebuild": "npm run validate",
    "prestart": "npm run validate",
    "pretest": "npm run validate",
    "postinstall": "echo 'Installation complete - ready for tutorial'",
    "posttest": "echo 'Test execution complete'"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "chokidar": "^4.0.1"
  },
  "peerDependencies": {},
  "optionalDependencies": {},
  "bundledDependencies": [],
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}