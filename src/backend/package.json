{
  "name": "nodejs-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial backend demonstrating Express 5.1.0, modern error handling, and educational best practices.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node ./scripts/start.js",
    "dev": "nodemon ./scripts/start.js",
    "test": "node ./scripts/test.js",
    "lint": "node ./scripts/lint.js",
    "format": "prettier --write \"src/**/*.js\"",
    "prepare": "npm run lint && npm run test"
  },
  "dependencies": {
    "express": "5.1.0",
    "body-parser": "^2.1.0",
    "dotenv": "^16.0.0",
    "on-headers": "^1.0.2",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.2.5",
    "jest": "^29.0.0",
    "supertest": "7.1.1",
    "@types/node": "latest",
    "@types/express": "5.0.3",
    "@types/jest": "latest",
    "nodemon": "latest"
  },
  "jest": {
    "preset": "node",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.spec.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/build/"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "plugin:promise/recommended",
      "plugin:import/recommended",
      "prettier"
    ],
    "plugins": [
      "node",
      "promise",
      "import"
    ],
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "hello-world",
    "educational",
    "backend",
    "api"
  ],
  "author": "Tutorial Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<org-or-user>/nodejs-tutorial-backend.git"
  },
  "bugs": {
    "url": "https://github.com/<org-or-user>/nodejs-tutorial-backend/issues"
  },
  "homepage": "https://github.com/<org-or-user>/nodejs-tutorial-backend#readme",
  "private": false
}